         "false <= 3" {} {:tokenType "LESS_EQUAL"
                          :errorType "Interpreter/EXPECTED_NUMERIC_OPERAND"
                          :lexeme "<="
                          :charPos 6}
         "\"hi\" <= \"hi\"" {} {:tokenType "LESS_EQUAL"
                                :errorType "Interpreter/EXPECTED_NUMERIC_OPERAND"
