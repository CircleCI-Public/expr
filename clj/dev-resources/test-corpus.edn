{:name ["scan-errors" "invalid-patterns"]
 :tests ["/foo(?:bar/" {} {:errorType "Scanner/INVALID_PATTERN"
                           :lexeme "/"
                           :charPos 0}
         "/foo⏰/" {} {:errorType "Scanner/INVALID_PATTERN_CHARACTER"
                      :lexeme "⏰"
                      :charPos 4}
         "/foo\\u23f0/" {} {:errorType "Scanner/INVALID_PATTERN_CHARACTER"
                            :lexeme "\\"
                            :charPos 4}
         "/foo\\x{23f0}/" {} {:errorType "Scanner/INVALID_PATTERN_CHARACTER"
                              :lexeme  "\\"
                              :charPos 4}

         ;; This specific case causes an infinite loop in pattern compilation
         ;; with re2j 1.8's scheme for handling Unicode case folding when run
         ;; on modern JVMs which support a higher version of Unicode.  Ensure
         ;; that we get an error
         "foo matches /(?i)bar \u1c80/" {"foo" "bar c"} {:errorType "Scanner/INVALID_PATTERN_CHARACTER"
                                                         :lexeme "\u1c80"
                                                         :charPos 21}

         "/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx/"
         {}
         {:errorType "Scanner/PATTERN_TOO_LONG"
          :lexeme "/"
