{:name "in"
 :options {:lists true}
 :tests [;; strings
         "x in [\"a\", \"b\"]" {"x" "a"} true
         "x in [\"a\", \"b\"]" {"x" "b"} true
         "x in [\"a\", \"b\"]" {"x" "c"} false
         "x in [\"a\"]" {"x" "A"} false
         ;; numbers
         "x in [1, 2, 3]" {"x" 2} true
         "x in [1, 2, 3]" {"x" 4} false
         "x in [0]" {"x" 0} true
         ;; booleans
         "x in [true]" {"x" true} true
         "x in [true]" {"x" false} false
         "x in [false]" {"x" false} true
         "x in [true, false]" {"x" false} true
         ;; upper-case IN
         "x IN [\"a\", \"b\"]" {"x" "b"} true
         "x IN [1, 2]" {"x" 3} false
         ;; literal left operand
         "\"a\" in [\"a\", \"b\"]" {} true
         "\"c\" in [\"a\", \"b\"]" {} false
         "2 in [1, 2]" {} true
         "true in [true]" {} true
         ;; operand types that differ from the element type never match
         "x in [1, 2]" {"x" "1"} false
         "x in [\"1\"]" {"x" 1} false
         "x in [true]" {"x" "true"} false
         ;; undefined left operand
         "x in [\"a\"]" {"x" nil} false
         "x in [1]" {"x" nil} false
         "x in [true]" {"x" nil} false
         ;; negation
         "not (x in [\"a\"])" {"x" "a"} false
         "not (x in [\"a\"])" {"x" "b"} true
         "not (x in [\"a\"])" {"x" nil} true
         ;; logical operators
         "x in [\"a\"] and y in [1, 2]" {"x" "a", "y" 2} true
         "x in [\"a\"] and y in [1, 2]" {"x" "a", "y" 3} false
         "x in [\"a\"] or y in [1, 2]" {"x" "b", "y" 3} false
         "x in [\"a\"] or y in [1, 2]" {"x" "b", "y" 1} true
         "x == 1 and y in [\"a\"]" {"x" 1, "y" "a"} true
         ;; comparison as the left operand
         "x > 1 in [true]" {"x" 2} true
         "x > 1 in [true]" {"x" 0} false
         ;; duplicates
         "x in [\"a\", \"a\"]" {"x" "a"} true
         "x in [1, 1, 1]" {"x" 2} false
         ;; `in` is left associative and binds as loosely as `==`
         "x in [\"a\"] == true" {"x" "a"} true
         "x in [\"a\"] == true" {"x" "b"} false
         "x == 1 in [true]" {"x" 1} true
         "x == 1 in [true]" {"x" 2} false
         "x in [\"a\"] in [true]" {"x" "a"} true
         "x in [\"a\"] in [true]" {"x" "b"} false
         ;; `not` binds tighter than `in`: (not x) in [true]
         "not x in [true]" {"x" false} true
         "not x in [true]" {"x" true} false]}

